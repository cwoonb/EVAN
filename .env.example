# Public browser configuration. Leave blank until the services are provisioned.
# Supabase publishable keys are public by design. Never place a secret/service_role
# key, a JWT signing secret, or the local vLLM address in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public HTTPS gateway endpoint; the private model URL stays in server/.env.
NEXT_PUBLIC_EVAN_API_URL=

# Local feed generation only. This path is never included in the browser bundle.
NEWS_CSV_PATH=
