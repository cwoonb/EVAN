# Server only. Never prefix these variables with NEXT_PUBLIC_.
# Local member accounts, comments, consented history, and 10/day AI quota.
# Takes precedence over the legacy shared-code/Supabase AI authentication.
MEMBER_AUTH_DB=/absolute/private/path/server/.state/members.sqlite3
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Optional personal-code mode (takes precedence over Supabase for AI only).
# Generate locally; never put credentials or access codes in NEXT_PUBLIC_*.
AI_CODE_AUTH_FILE=
NEWS_CSV_PATH=/absolute/private/path/news/outputs/news_analysis.csv
ALLOWED_ORIGINS=https://cwoonb.github.io,http://localhost:3000
VLLM_BASE_URL=http://127.0.0.1:8000/v1
QWEN_MODEL=qwen3.8-27b
# Optional only when the existing vLLM requires a key.
VLLM_API_KEY=
RATE_LIMIT_DB=server/.state/rate-limits.sqlite3
CHAT_REQUESTS_PER_MINUTE=6
CHAT_REQUESTS_PER_DAY=100
